<Page x:Class="CinemaPremiereApp.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiereApp.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classes="clr-namespace:CinemaPremiereApp.Classes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{materialDesign:MaterialDesignFont}"
      Language="ru-RU"
      mc:Ignorable="d" 
      d:DesignHeight="670"
      d:DesignWidth="1280"
      Title="Настройки">
    <materialDesign:DialogHost Identifier="OrdersPageDialogHost"
                               Name="MainDialogHost">
        <Grid>
            <StackPanel Margin="20">
                <TextBlock Text="Настройки"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <TextBlock Text="Выберите основной цвет приложения:"
                           Margin="0 0 0 5"/>

                <ComboBox Name="ColorComboBox"
                          Width="200"
                          HorizontalAlignment="Left"
                          SelectionChanged="ColorComboBoxSelectionChanged">
                    <ComboBoxItem Content="Синий" Tag="Blue"/>
                    <ComboBoxItem Content="Морской" Tag="Indigo"/>
                    <ComboBoxItem Content="Голубой" Tag="LightBlue"/>
                    <ComboBoxItem Content="Бирюзовый" Tag="Cyan"/>
                    <ComboBoxItem Content="Морская волна" Tag="Teal"/>
                    
                    <ComboBoxItem Content="Фиолетовый" Tag="DeepPurple"/>
                    <ComboBoxItem Content="Розовый" Tag="Pink"/>
                    <ComboBoxItem Content="Красный" Tag="Red"/>
                    <ComboBoxItem Content="Оранжевый" Tag="Orange"/>
                    <ComboBoxItem Content="Янтарный" Tag="Amber"/>
                    <ComboBoxItem Content="Глубокий оранжевый" Tag="DeepOrange"/>
                    
                    <ComboBoxItem Content="Зеленый" Tag="Green"/>
                    <ComboBoxItem Content="Салатовый" Tag="Lime"/>
                    <ComboBoxItem Content="Коричневый" Tag="Brown"/>
                    <ComboBoxItem Content="Серо-голубой" Tag="BlueGrey"/>
                </ComboBox>
            </StackPanel>
        </Grid>
    </materialDesign:DialogHost>
</Page>
