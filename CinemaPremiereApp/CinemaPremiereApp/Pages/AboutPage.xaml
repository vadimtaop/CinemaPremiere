<Page x:Class="CinemaPremiereApp.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiereApp.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classes="clr-namespace:CinemaPremiereApp.Classes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{materialDesign:MaterialDesignFont}"
      Language="ru-RU"
      mc:Ignorable="d" 
      d:DesignHeight="670"
      d:DesignWidth="1280"
      Title="О программе">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                
                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 30">
                    <materialDesign:PackIcon Kind="Information"
                                             Width="30"
                                             Height="30"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="О программе"
                               FontSize="28"
                               FontWeight="Bold"
                               Margin="15 0 0 0"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <materialDesign:Card Width="500"
                                         Margin="0 0 20 20"
                                         UniformCornerRadius="10"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel>
                            <materialDesign:ColorZone Mode="PrimaryMid"
                                                      Padding="20"
                                                      CornerRadius="10 10 0 0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MovieOpen"
                                                             Width="48"
                                                             Height="48"
                                                             VerticalAlignment="Center"/>
                                    <StackPanel Margin="15 0 0 0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Кинотеатр «Премьера»"
                                                   FontSize="26"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Версия 1.0 (Сборка 2026)"
                                                   FontSize="14"
                                                   Opacity="0.8"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:ColorZone>

                            <Border Padding="25">
                                <StackPanel>
                                    <TextBlock Text="   Программный комплекс для автоматизации работы кинотеатра. Приложение предоставляет инструменты для удобного ведения расписания сеансов, управления базой фильмов, учета проданных билетов и формирования аналитической отчетности."
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               LineHeight="22"
                                               TextAlignment="Justify"/>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0 20 0 0">
                                        <materialDesign:PackIcon Kind="CheckDecagram"
                                                                 Height="20"
                                                                 Width="20"
                                                                 Opacity="0.8"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Лицензия: Все права защищены"
                                                   Margin="8 0 0 0"
                                                   Opacity="0.8"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Width="400"
                                         Margin="0 0 20 20"
                                         UniformCornerRadius="10"
                                         Padding="25"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="AccountTie"
                                                         Height="28"
                                                         Width="28"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Разработчик"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource MaterialDesignDivider}"
                                       Margin="0 0 0 20"/>

                            <TextBlock Text="Выполнил студент:"
                                       FontSize="14"
                                       Opacity="0.8"
                                       Margin="0 0 0 2"/>
                            <TextBlock Text="Мухин Вадим Юрьевич"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Margin="0 0 0 15"/>

                            <TextBlock Text="Учебное заведение:"
                                       FontSize="14"
                                       Opacity="0.8"
                                       Margin="0 0 0 2"/>
                            <TextBlock Text="ГБПОУ «Починковский сельско-хозяйственный техникум»"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       FontWeight="Medium"
                                       Margin="0 0 0 15"/>

                            <TextBlock Text="Специальность:"
                                       FontSize="14"
                                       Opacity="0.8"
                                       Margin="0 0 0 2"/>
                            <TextBlock Text="09.02.07 Информационные системы и программирование"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       FontWeight="Medium"
                                       Margin="0 0 0 15"/>

                            <TextBlock Text="База практики:"
                                       FontSize="14"
                                       Opacity="0.8"
                                       Margin="0 0 0 2"/>
                            <TextBlock Text="МБУК «Починковский культурно-досуговый центр»"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       FontWeight="Medium"
                                       Margin="0 0 0 15"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Width="300"
                                         Margin="0 0 20 20"
                                         UniformCornerRadius="10"
                                         Padding="25"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="MonitorDashboard"
                                                         Height="28"
                                                         Width="28"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Система"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource MaterialDesignDivider}"
                                       Margin="0 0 0 20"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="MicrosoftWindows"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.6"/>
                                <TextBlock Text="ОС: Windows 10 / 11"
                                           FontSize="16"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="DotNet"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.6"/>
                                <TextBlock Text="Среда: .NET Framework"
                                           FontSize="16"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="Database"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.6"/>
                                <TextBlock Text="СУБД: MS SQL Server"
                                           FontSize="16"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="Memory"
                                                         VerticalAlignment="Center"
                                                         Opacity="0.6"/>
                                <TextBlock Text="ОЗУ: от 4 ГБ"
                                           FontSize="16"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Width="1240"
                                         Margin="0 0 20 20"
                                         UniformCornerRadius="10"
                                         Padding="25"
                                         materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 0 0 15">
                                <materialDesign:PackIcon Kind="CodeBraces"
                                                         Height="28"
                                                         Width="28"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Стек технологий"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="10 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource MaterialDesignDivider}"
                                       Margin="0 0 0 20"/>

                            <WrapPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="15"
                                        Padding="15 8"
                                        Margin="0 0 10 10">
                                    <TextBlock Text="C# / .NET Framework"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="15"
                                        Padding="15 8"
                                        Margin="0 0 10 10">
                                    <TextBlock Text="WPF (Windows Presentation Foundation)"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="15"
                                        Padding="15 8"
                                        Margin="0 0 10 10">
                                    <TextBlock Text="Entity Framework 6"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="15"
                                        Padding="15 8"
                                        Margin="0 0 10 10">
                                    <TextBlock Text="Material Design in XAML"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="15"
                                        Padding="15 8"
                                        Margin="0 0 10 10">
                                    <TextBlock Text="Newtonsoft.Json"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        CornerRadius="15"
                                        Padding="15 8"
                                        Margin="0 0 10 10">
                                    <TextBlock Text="ClosedXML"
                                               FontWeight="Medium"
                                               FontSize="14"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"/>
                                </Border>
                            </WrapPanel>

                        </StackPanel>
                    </materialDesign:Card>
                </WrapPanel>
                
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesignDivider}"
                Padding="15"
                Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="© 2026 Кинотеатр «Премьера». Все права защищены"
                           FontSize="14"
                           Opacity="0.7"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
    </Grid>
</Page>
