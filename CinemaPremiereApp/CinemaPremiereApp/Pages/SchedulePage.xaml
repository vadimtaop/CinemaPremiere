<Page x:Class="CinemaPremiereApp.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiereApp.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classes="clr-namespace:CinemaPremiereApp.Classes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{materialDesign:MaterialDesignFont}"
      Language="ru-RU"
      mc:Ignorable="d" 
      d:DesignHeight="670"
      d:DesignWidth="1280"
      Title="Расписание">
    <materialDesign:DialogHost Identifier="SchedulePageDialogHost">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="20"
                        Width="400">
                <TextBlock Text="Выберите фильм из базы"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0 0 0 10"/>

                <ListBox Name="FilmsListBox"
                         ItemsSource="{Binding AvailableFilms}"
                         MaxHeight="400">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <Image Source="{Binding PosterPath}"
                                       Width="40"
                                       Height="60"
                                       Stretch="UniformToFill"/>
                                <StackPanel Margin="10 0">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding GenresDisplay}"
                                               FontSize="12"
                                               Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 20 0 0">
                    <Button Content="Добавить"
                            Click="AddSelectedMovieButtonClick"
                            IsDefault="True"/>
                    <Button Content="Отмена"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0 0 1 0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15 15">
                        <StackPanel Margin="0 0 0 20">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="Cog"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Оформление"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBox Name="TitleTextBox"
                                         materialDesign:HintAssist.Hint="Главный заголовок"
                                         materialDesign:HintAssist.HintHorizontalAlignment="Center"
                                         FontSize="14"
                                         LostFocus="SyncSaveEvent"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                <TextBox Name="SubtitleTextBox"
                                         materialDesign:HintAssist.Hint="Подзаголовок"
                                         materialDesign:HintAssist.HintHorizontalAlignment="Center"
                                         Margin="0 10 0 0"
                                         FontSize="14"
                                         LostFocus="SyncSaveEvent"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                <TextBox Name="PhoneTextBox"
                                         materialDesign:HintAssist.Hint="Номер телефона"
                                         materialDesign:HintAssist.HintHorizontalAlignment="Center"
                                         Margin="0 10 0 0"
                                         FontSize="14"
                                         LostFocus="SyncSaveEvent"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="MovieEdit"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Контент"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 5">
                                <Button Content="Добавить день"
                                        Click="AddDayButtonClick"
                                        FontSize="14"
                                        Width="170"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>

                                <Button Content="Выбрать фильмы"
                                        FontSize="14"
                                        Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Width="170"
                                        Margin="10 0 0 0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 5">
                                <Button Content="Сбросить постеры"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        FontSize="14"
                                        Width="170"
                                        Click="ClearPostersButtonClick"/>

                                <Button Content="Сбросить сеансы"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        FontSize="14"
                                        Width="170"
                                        Margin="10 0 0 0"
                                        Click="ClearSessionsButtonClick"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="CalendarClock"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Сеансы"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding DateText}"
                                                  Margin="0 2"
                                                  Style="{StaticResource MaterialDesignExpander}">
                                            <StackPanel Margin="10 5">
                                                <TextBox materialDesign:HintAssist.Hint="Дата"
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         FontSize="14"
                                                         Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0 0 0 10"/>

                                                <ItemsControl ItemsSource="{Binding Sessions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0 5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="45"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="45"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}"
                                                                         materialDesign:HintAssist.Hint="Время"
                                                                         Margin="2"
                                                                         FontSize="14"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding DataContext.Movies, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          DisplayMemberPath="Title"
                                                                          SelectedValuePath="Title"
                                                                          SelectedValue="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          materialDesign:HintAssist.Hint="Фильм"
                                                                          Margin="2"
                                                                          FontSize="14"/>
                                                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                                         Grid.Column="2"
                                                                         FontSize="14"
                                                                         materialDesign:HintAssist.Hint="Цена"
                                                                         Margin="2"/>
                                                                <Button Grid.Column="3"
                                                                        Padding="0"
                                                                        Width="20"
                                                                        Height="20"
                                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                                        Click="RemoveSessionButtonClick">
                                                                    <materialDesign:PackIcon Kind="Close"
                                                                                             Width="14"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            Margin="0 10 0 0">
                                                    <Button Content="Удалить день"
                                                            FontSize="14"
                                                            Width="150"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Click="RemoveDayButtonClick"/>
                                                    <Button Content="Добавить сеанс"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            FontSize="14"
                                                            Width="150"
                                                            Margin="10 0 0 0"
                                                            Click="AddSessionToDayButtonClick"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="ContentSave"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Сохранение"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Name="ExportButton"
                                    FontSize="14"
                                    Click="ExportButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Image"/>
                                    <TextBlock Text="Экспорт в PNG / JPEG"
                                               Margin="10 0 0 0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1"
                  Background="{DynamicResource MaterialDesignDarkSeparatorBackground}">
                <Viewbox Margin="40">
                    <Grid Name="ExportGrid"
                          Width="1920"
                          Height="1080">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="#A2BDF4"
                                              Offset="0"/>
                                <GradientStop Color="#03103F"
                                              Offset="0.5"/>
                                <GradientStop Color="#CE991D7E"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="450"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0 0 0 10"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ElementName=TitleTextBox, Path=Text}"
                                       FontSize="140"
                                       FontWeight="Black"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0.5,0"
                                                         EndPoint="0.5,1">
                                        <GradientStop Color="#971A80"
                                                      Offset="1"/>
                                        <GradientStop Color="#D9D9D9"
                                                      Offset="0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Color="Black"
                                                      Opacity="0.25"
                                                      ShadowDepth="5.6"
                                                      Direction="315"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock Text="{Binding ElementName=SubtitleTextBox, Path=Text}"
                                       FontSize="70"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0 -30 0 0"
                                       HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Color="Black"
                                                      Opacity="0.25"
                                                      ShadowDepth="5.6"
                                                      Direction="315"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <Image Source="/Images/Logo.png"
                               Grid.Row="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0 10 10 0"
                               Width="170"/>

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Movies}"
                                      Margin="0 10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#70991D7E"
                                            CornerRadius="25"
                                            Padding="15"
                                            Width="200"
                                            Height="Auto"
                                            Margin="10 0"
                                            VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="250"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Border CornerRadius="15"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ImagePath}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <Button Width="26"
                                                        Height="26"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0 5 5 0"
                                                        Padding="0"
                                                        Background="#90000000"
                                                        BorderBrush="Transparent"
                                                        Tag="HideOnExport"
                                                        Click="RemoveMovieButtonClick"
                                                        Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}">
                                                    <materialDesign:PackIcon Kind="Close"
                                                                             Width="14"
                                                                             Height="14"
                                                                             Foreground="White"/>
                                                </Button>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0 5 0 0"
                                                        VerticalAlignment="Top">
                                                <TextBlock Text="{Binding AgeRating}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Genre}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Width="170"
                                                           FontSize="16"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding Days}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="30 30 30 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="430"
                                            Height="390"
                                            Background="#03103F"
                                            CornerRadius="25"
                                            Margin="20 0"
                                            Padding="15"
                                            BorderBrush="Black"
                                            BorderThickness="2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15"
                                                              Color="Black"
                                                              Opacity="0.5"
                                                              ShadowDepth="0"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DateText}"
                                                       FontSize="36"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       Margin="0 -5 0 0"/>

                                            <Grid Grid.Row="1"
                                                  Margin="0 5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="ВРЕМЯ"
                                                           FontSize="24"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Grid.Column="0"/>
                                                <TextBlock Text="НАЗВАНИЕ"
                                                           FontSize="24"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Grid.Column="1"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ЦЕНА"
                                                           FontSize="24"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Grid.Column="2"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>

                                            <ItemsControl Grid.Row="2"
                                                          ItemsSource="{Binding Sessions}"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0 7 0 7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Time}"
                                                                       FontSize="20"
                                                                       Foreground="White"
                                                                       Grid.Column="0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="20"
                                                                       Foreground="White"
                                                                       Grid.Column="1"
                                                                       HorizontalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Price}"
                                                                       FontSize="20"
                                                                       Foreground="White"
                                                                       Grid.Column="2"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding ElementName=PhoneTextBox, Path=Text, StringFormat=ИНФОРМАЦИЯ: {0}}"
                                   Grid.Row="3"
                                   FontSize="30"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Viewbox>
            </Grid>

        </Grid>
    </materialDesign:DialogHost>
</Page>
