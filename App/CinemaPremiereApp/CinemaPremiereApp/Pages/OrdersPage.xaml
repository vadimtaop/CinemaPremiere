<Page x:Class="CinemaPremiereApp.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiereApp.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classes="clr-namespace:CinemaPremiereApp.Classes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{materialDesign:MaterialDesignFont}"
      Language="ru-RU"
      mc:Ignorable="d" 
      d:DesignHeight="670"
      d:DesignWidth="1280"
      Title="Заказы">
    <materialDesign:DialogHost Identifier="OrdersPageDialogHost"
                               Name="MainDialogHost">
        <materialDesign:DialogHost.DialogContent>
            <Border Padding="20"
                    MinWidth="700"
                    MinHeight="400"
                    Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Добавление нового заказа"
                               FontSize="20"
                               FontWeight="Bold"
                               Grid.Row="0"
                               TextWrapping="Wrap"
                               Name="TitleDialogTextBlock"/>

                    <StackPanel HorizontalAlignment="Center"
                                Margin="0 0 0 0"
                                Grid.Row="1">
                        <ComboBox Name="AddFilmComboBox"
                                  FontSize="14"
                                  materialDesign:HintAssist.Hint="Название фильма"
                                  DisplayMemberPath="Title"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="Title"
                                  materialDesign:TextFieldAssist.HasClearButton="True"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                        <Grid Margin="0 20 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Name="AddSessionDatePicker"
                                        materialDesign:HintAssist.Hint="Дата сеанса"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                        FontSize="14"
                                        Grid.Column="0"
                                        Margin="0 0 5 0"/>

                            <DatePicker Name="AddBuyDatePicker"
                                        materialDesign:HintAssist.Hint="Дата покупки"
                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                        FontSize="14"
                                        Grid.Column="1"
                                        Margin="5 0 0 0"/>
                        </Grid>

                        <StackPanel Margin="0 20 0 0">
                            <TextBlock Text="Фиксированные цены"
                                       FontSize="14"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center"/>

                            <ItemsControl Name="PriceTemplatesItemsControl"
                                          HorizontalAlignment="Center"
                                          Margin="0 10 0 0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Tag="{Binding}"
                                                Click="QuickPriceButtonClick"
                                                Height="30"
                                                FontSize="14"
                                                Margin="5 0 5 0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Margin="0 20 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="AddPriceTextBox"
                                     FontSize="14"
                                     Grid.Column="0"
                                     Margin="0 0 0 0"
                                     MaxLength="50"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     TextChanged="CalculateTotalSum"
                                     PreviewKeyDown="SpaceValidationPreviewKeyDown"
                                     PreviewTextInput="NumberValidationTextBox"
                                     materialDesign:HintAssist.Hint="Стоимость билета"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <materialDesign:NumericUpDown Name="AddCountTicketsUpDown"
                                                          FontSize="14"
                                                          Grid.Column="1"
                                                          Margin="10 0 10 0"
                                                          Minimum="1"
                                                          Maximum="300"
                                                          Value="1"
                                                          PreviewTextInput="NumberValidationTextBox"
                                                          PreviewKeyDown="SpaceValidationPreviewKeyDown"
                                                          materialDesign:HintAssist.Hint="Кол-во билетов"
                                                          ValueChanged="AddCountTicketUpDownValueChanged"
                                                          Style="{StaticResource MaterialDesignFloatingHintNumericUpDown}"/>

                            <TextBox Name="AddTotalSumTextBox"
                                     FontSize="14"
                                     Grid.Column="2"
                                     IsReadOnly="True"
                                     materialDesign:HintAssist.Hint="Итоговая сумма"
                                     MaxLength="50"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </Grid>

                        <ComboBox Name="AddPaymentTypeComboBox"
                                  FontSize="14"
                                  Margin="0 10 0 0"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="Способ оплаты"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                        <TextBox Name="AddNoteTextBox"
                                 FontSize="14"
                                 Margin="0 10 0 0"
                                 TextWrapping="Wrap"
                                 Width="500"
                                 MaxHeight="100"
                                 MaxLength="255"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                 materialDesign:HintAssist.Hint="Заметка"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0 20 0 0"
                                Grid.Row="2">
                        <Button Content="Отмена"
                                IsCancel="True"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
                        <Button Content="Сохранить"
                                Click="SaveOrderButtonClick"
                                Margin="10 0 0 0"
                                IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="0 0 1 0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15 15">
                        <StackPanel Margin="0 0 0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="FilterVariant"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Фильтры"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Name="SearchTextBox"
                                     Margin="0 0 0 0"
                                     FontSize="14"
                                     MaxLength="50"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     TextChanged="SearchTextBoxTextChanged"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Название фильма"
                                     materialDesign:HintAssist.HintHorizontalAlignment="Center"
                                     materialDesign:TextFieldAssist.HasClearButton="True"/>

                            <TextBlock Text="Дата сеанса"
                                       Margin="0 15 0 0"
                                       Opacity="0.6"
                                       FontSize="14"
                                       TextAlignment="Center"/>

                            <DockPanel Margin="0 5 0 0">
                                <DatePicker Name="StartSessionDatePicker"
                                            Width="95"
                                            HorizontalAlignment="Left"
                                            FontSize="14"
                                            materialDesign:HintAssist.Hint="Дата с..."
                                            SelectedDateChanged="FilterSelectionChanged"
                                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>

                                <DatePicker Name="EndSessionDatePicker"
                                            Width="95"
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            materialDesign:HintAssist.Hint="Дата по..."
                                            SelectedDateChanged="FilterSelectionChanged"
                                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                            </DockPanel>

                            <TextBlock Text="Дата покупки"
                                       Margin="0 15 0 0"
                                       Opacity="0.6"
                                       FontSize="14"
                                       TextAlignment="Center"/>

                            <DockPanel Margin="0 5 0 0">
                                <DatePicker Name="StartBuyDatePicker"
                                            Width="95"
                                            HorizontalAlignment="Left"
                                            FontSize="14"
                                            materialDesign:HintAssist.Hint="Дата с..."
                                            SelectedDateChanged="FilterSelectionChanged"
                                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>

                                <DatePicker Name="EndBuyDatePicker"
                                            Width="95"
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            materialDesign:HintAssist.Hint="Дата по..."
                                            SelectedDateChanged="FilterSelectionChanged"
                                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
                            </DockPanel>

                            <ComboBox Name="DatePresetComboBox"
                                      Margin="0 15 0 0"
                                      SelectedIndex="1"
                                      FontSize="14"
                                      SelectionChanged="DatePresetComboBoxSelectionChanged"
                                      materialDesign:HintAssist.Hint="Период покупки"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <ComboBoxItem Content="Произвольный"
                                              Tag="Custom"/>
                                <ComboBoxItem Content="Сегодня"
                                              Tag="Today"/>
                                <ComboBoxItem Content="Вчера"
                                              Tag="Yesterday"/>
                                <ComboBoxItem Content="Эта неделя"
                                              Tag="Week"/>
                                <ComboBoxItem Content="Этот месяц"
                                              Tag="Month"/>
                            </ComboBox>

                            <Expander Header="Способ оплаты"
                                      Margin="0 10 0 0"
                                      IsExpanded="True"
                                      Style="{StaticResource MaterialDesignExpander}">
                                <ListBox Name="PaymentTypeListBox"
                                         FontSize="14"
                                         MaxHeight="250"
                                         SelectionMode="Multiple"
                                         SelectionChanged="FilterSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                      IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Name}"
                                                           TextWrapping="Wrap"
                                                           FontSize="14"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20 0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="Settings"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Вид"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Отображать заказов:"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>

                                <ComboBox Name="PageSizeComboBox"
                                          HorizontalAlignment="Right"
                                          Width="55"
                                          FontSize="13"
                                          Margin="10 0 0 0"
                                          Padding="13 0 0 0"
                                          SelectionChanged="PageSizeComboBoxSelectionChanged"
                                          Style="{StaticResource MaterialDesignComboBox}">
                                    <ComboBoxItem Content="10"
                                                  Tag="10"/>
                                    <ComboBoxItem Content="20"
                                                  Tag="20"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="50"
                                                  Tag="50"/>
                                    <ComboBoxItem Content="100"
                                                  Tag="100"/>
                                </ComboBox>
                            </DockPanel>

                            <ComboBox Name="SortComboBox"
                                      Margin="0 10 0 0"
                                      FontSize="14"
                                      SelectedIndex="0"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="Сортировка"
                                      SelectionChanged="FilterSelectionChanged">
                                <ComboBoxItem Content="Без сортировки"
                                              Tag="0"/>
                                <ComboBoxItem Content="Сначала новые (по дате покупки)"
                                              Tag="1"/>
                                <ComboBoxItem Content="Сначала новые (по дате сеанса)"
                                              Tag="2"/>
                                <ComboBoxItem Content="По названию фильма (А-Я)"
                                              Tag="3"/>
                                <ComboBoxItem Content="Сумма (по убыванию)"
                                              Tag="4"/>
                                <ComboBoxItem Content="Количество билетов (по убыванию)"
                                              Tag="5"/>
                                <ComboBoxItem Content="Тип оплаты (А-Я)"
                                              Tag="6"/>
                            </ComboBox>

                            <CheckBox Name="ShowNotesCheckBox"
                                      Content="Отображать заметки"
                                      IsChecked="True"
                                      FontSize="14"
                                      Margin="0 10 0 0"/>

                            <CheckBox Name="OnlyWithNotesCheckBox"
                                      Content="Только с заметками"
                                      Click="FilterCheckBoxClick"
                                      FontSize="14"
                                      Margin="0 5 0 0"/>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20 0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="Settings"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Статистика"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 10 0 0">
                                <materialDesign:PackIcon Kind="CashMultiple"
                                                         VerticalAlignment="Center"
                                                         Width="16"
                                                         Height="16"/>
                                <TextBlock Name="TotalSummaryTextBlock"
                                           Text="Всего: 0 ₽ / 0 шт."
                                           FontSize="14"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 10 0 0">
                                <materialDesign:PackIcon Kind="CreditCard"
                                                         VerticalAlignment="Center"
                                                         Width="16"
                                                         Height="16"/>
                                <TextBlock Name="BankStatsTextBlock"
                                           Text="Банк: 0 ₽ / 0 шт."
                                           FontSize="14"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 10 0 0">
                                <materialDesign:PackIcon Kind="AccountCard"
                                                         VerticalAlignment="Center"
                                                         Width="16"
                                                         Height="16"/>
                                <TextBlock Name="PushkinStatsTextBlock"
                                           Text="Пушка: 0 ₽ / 0 шт."
                                           FontSize="14"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0 10 0 0">
                                <materialDesign:PackIcon Kind="Web"
                                                         VerticalAlignment="Center"
                                                         Width="16"
                                                         Height="16"/>
                                <TextBlock Name="CashStatsTextBlock"
                                           Text="Внешка: 0 ₽ / 0 шт."
                                           FontSize="14"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20 0 0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="DatabaseArrowUp"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Данные"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="10 0">
                                <Button ToolTip="Экспорт в Excel"
                                        Click="ExportToExcelButtonClick"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExcel"/>
                                        <TextBlock Text="Экспорт в Excel"
                                                   Margin="10 0 0 0"/>
                                    </StackPanel>
                                </Button>
                                <Button ToolTip="Экспорт в CSV"
                                        Click="ExportToCsvButtonClick"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileCsv"/>
                                        <TextBlock Text="Экспорт в CSV"
                                                   Margin="10 0 0 0"/>
                                    </StackPanel>
                                </Button>
                                <Button ToolTip="Экспорт в JSON"
                                        Click="ExportToJsonButtonClick"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CodeJson"/>
                                        <TextBlock Text="Экспорт в JSON"
                                                   Margin="10 0 0 0"/>
                                    </StackPanel>
                                </Button>

                                <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                                <Button ToolTip="Импорт из CSV"
                                        Click="ImportFromCsvButtonClick"
                                        Style="{StaticResource MaterialDesignFlatButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileImport"/>
                                        <TextBlock Text="Импорт из CSV"
                                                   Margin="10 0 0 0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="Сбросить параметры"
                                Margin="0 10 0 0"
                                Height="30"
                                Click="ResetFiltersButtonClick"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Button Margin="0 0 30 10"
                        Grid.Row="0"
                        Panel.ZIndex="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="AddOrderButtonClick"
                        ToolTip="Добавить заказ"
                        Style="{StaticResource MaterialDesignFloatingActionButton}">
                    <materialDesign:PackIcon Kind="Plus"
                                             Width="24"
                                             Height="24"/>
                </Button>

                <DataGrid Name="OrdersDataGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="OrdersDataGridSelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell"
                               BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="FocusVisualStyle"
                                    Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MaterialDesignBody}"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow"
                               BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <EventSetter Event="PreviewMouseLeftButtonDown"
                                         Handler="PreviewMouseLeftButtonDownDataGrid"/>
                            <EventSetter Event="PreviewMouseRightButtonDown"
                                         Handler="PreviewMouseRightButtonDownDataGrid"/>
                            <EventSetter Event="MouseEnter"
                                         Handler="MouseEnterDataGrid"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource MaterialDesignDivider}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Редактировать"
                                      Click="EditOrderMenuItemButtonClick">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Pencil"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Удалить"
                                      Click="DeleteOrderMenuItemButtonClick">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn MinWidth="60" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.2"
                                                            ScaleY="1.2"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Заказ"
                                                MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding OrderId, StringFormat=№ {0}}"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="{Binding BuyDate, StringFormat=dd.MM.yyyy}"
                                                   Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Сеанс"
                                                MinWidth="250"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Films.Title}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="Medium"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SessionDate, StringFormat=dd.MM.yyyy}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}"
                                                       Opacity="0.6"
                                                       Margin="10 0 0 0"/>
                                        </StackPanel>

                                        <Border CornerRadius="5"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                                BorderThickness="5 0 0 0"
                                                Padding="6"
                                                HorizontalAlignment="Left"
                                                Margin="0 8 0 0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Note}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Note}"
                                                                     Value="">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ShowNotesCheckBox}"
                                                                     Value="False">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="InformationOutline"
                                                                         VerticalAlignment="Center"
                                                                         Width="15" 
                                                                         Height="15"
                                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                <TextBlock Text="{Binding Note}"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                           TextWrapping="Wrap"
                                                           FontStyle="Italic"
                                                           Margin="5 0 0 0"
                                                           MaxWidth="600"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Оплата"
                                                MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalSum, StringFormat={}{0:N0} ₽}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CountTickets, StringFormat={}{0} шт.}"
                                                       Opacity="0.6"/>
                                            <TextBlock Text="{Binding PaymentTypes.Name}"
                                                       Opacity="0.6"
                                                       Margin="7 0 0 0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Name="EmptyStackPanel"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="SmileySad"
                                             Width="80"
                                             Height="80"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesignDivider}"/>

                    <TextBlock Text="Упс! Ничего не найдено"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0 10 0 0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                    <TextBlock Text="Попробуйте изменить параметры поиска или фильтры"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Opacity="0.6"/>

                    <Button Content="Сбросить всё"
                            Margin="0 20 0 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="ResetFiltersButtonClick"/>
                </StackPanel>

                <materialDesign:Card Name="SelectionPanel"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center"
                                     Margin="0 0 0 20"
                                     Padding="10 2"
                                     UniformCornerRadius="15"
                                     Background="Transparent"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                     Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="SelectionCountTextBlock"
                                   Text="Выбрано: 0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                        <Button Content="Удалить"
                                Click="DeleteSelectionOrdersButtoncClick"
                                Width="150"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="10 0 0 0"/>
                        <Button Content="Снять выделение"
                                Click="ClearSelectionButtonClick"
                                Width="150"
                                Style="{StaticResource MaterialDesignFlatButton}"/>
                    </StackPanel>
                </materialDesign:Card>

                <Border Grid.Row="1"
                        Margin="10"
                        VerticalAlignment="Center"
                        BorderThickness="0 1 0 0"
                        Background="{DynamicResource MaterialDesignPaper}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <Grid>
                        <TextBlock Name="CounterTextBlock"
                                   Text="Найдено: 0 из 0"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button Content="&lt;&lt;"
                                    Height="30"
                                    Width="50"
                                    Click="FirstPageButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Button Content="&lt;"
                                    Height="30"
                                    Width="50"
                                    Click="PrevPageButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="15 0">
                                <TextBlock Text="Страница"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0 0 8 0"/>

                                <TextBox Name="PageInputTextBox"
                                         FontSize="16"
                                         Width="30"
                                         TextAlignment="Center"
                                         MaxLength="3"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         materialDesign:TextFieldAssist.HasClearButton="False"
                                         KeyDown="PageInputTextBoxKeyDown"
                                         Text="1"/>

                                <TextBlock Name="PageInfoTextBlock"
                                           FontSize="16"
                                           Text="из 1"
                                           VerticalAlignment="Center"
                                           Margin="8 0 0 0"/>
                            </StackPanel>

                            <Button Content="&gt;"
                                    Height="30"
                                    Width="50"
                                    Click="NextPageButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Button Content="&gt;&gt;"
                                    Height="30"
                                    Width="50"
                                    Click="LastPageButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

        </Grid>


    </materialDesign:DialogHost>
</Page>
