<Page x:Class="CinemaPremiereApp.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CinemaPremiereApp.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classes="clr-namespace:CinemaPremiereApp.Classes"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      Background="{DynamicResource MaterialDesignPaper}"
      FontFamily="{materialDesign:MaterialDesignFont}"
      Language="ru-RU"
      mc:Ignorable="d" 
      d:DesignHeight="670"
      d:DesignWidth="1280"
      Title="Пользователи">
    <materialDesign:DialogHost Identifier="UserPageDialogHost"
                               Name="MainDialogHost">
        <materialDesign:DialogHost.DialogContent>
            <Border Padding="30"
                    MinWidth="400"
                    Background="{DynamicResource MaterialDesignPaper}" 
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Grid.Row="0"
                                Margin="0 0 0 20">
                        <materialDesign:PackIcon Kind="Account"
                                                 Width="26"
                                                 Height="26" 
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Учетная запись" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Margin="10 0 0 0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBox Name="LoginTextBox"
                                 materialDesign:HintAssist.Hint="Логин"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 FontSize="14" 
                                 Margin="0 10 0 0" 
                                 MaxLength="50"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"/>

                        <PasswordBox Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="Пароль (пусто = без изменений)"
                                     Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"
                                     FontSize="14" 
                                     Margin="0 20 0 0"
                                     MaxLength="50"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"/>

                        <ComboBox Name="RoleComboBox"
                                  materialDesign:HintAssist.Hint="Роль"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  FontSize="14" 
                                  Margin="0 20 0 0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Grid.Row="2"
                                Margin="0 30 0 0">
                        <Button Content="Отмена"
                                IsCancel="True" 
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0 0 15 0"
                                Width="100"/>
                        <Button Name="SaveButton" 
                                Content="Сохранить" 
                                Click="SaveUserButtonClick"
                                IsDefault="True"
                                Width="130"/>
                    </StackPanel>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    BorderThickness="0 0 1 0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15 15">
                        <StackPanel Margin="0 0 0 20">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" 
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="FilterVariant"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Фильтры" 
                                           FontSize="18" 
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox Name="SearchTextBox"
                                     Margin="0 0 0 0"
                                     FontSize="14"
                                     MaxLength="50"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     TextChanged="FilterSelectionChanged"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Поиск по логину"
                                     materialDesign:HintAssist.HintHorizontalAlignment="Center"
                                     materialDesign:TextFieldAssist.HasClearButton="True"/>

                            <ComboBox Name="RoleFilterComboBox"
                                      Margin="0 15 0 0" 
                                      FontSize="14"
                                      SelectionChanged="FilterSelectionChanged"
                                      materialDesign:HintAssist.Hint="Роль"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                            </ComboBox>
                        </StackPanel>

                        <Separator Background="{DynamicResource MaterialDesignDivider}"/>

                        <StackPanel Margin="0 20 0 20">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center" 
                                        Margin="0 0 0 10">
                                <materialDesign:PackIcon Kind="Settings"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Вид"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Отображать:"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <ComboBox Name="PageSizeComboBox"
                                          HorizontalAlignment="Right" 
                                          Width="55"
                                          FontSize="13"
                                          Margin="10 0 0 0" 
                                          Padding="15 0 0 0"
                                          SelectionChanged="PageSizeComboBoxSelectionChanged"
                                          Style="{StaticResource MaterialDesignComboBox}">
                                    <ComboBoxItem Content="10" 
                                                  Tag="10"
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="20"
                                                  Tag="20"/>
                                    <ComboBoxItem Content="50"
                                                  Tag="50"/>
                                </ComboBox>
                            </DockPanel>

                            <ComboBox Name="SortComboBox"
                                      materialDesign:HintAssist.Hint="Сортировка"
                                      Margin="0 15 0 0" 
                                      FontSize="14" 
                                      SelectedIndex="2"
                                      SelectionChanged="FilterSelectionChanged"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <ComboBoxItem Content="Без сортировки" 
                                              Tag="0"/>
                                <ComboBoxItem Content="Логин (А-Я)" 
                                              Tag="1"/>
                                <ComboBoxItem Content="Роль" 
                                              Tag="2"/>
                                <ComboBoxItem Content="Сначала заблокированные" 
                                              Tag="3"/>
                            </ComboBox>
                        </StackPanel>

                        <Button Content="Сбросить параметры"
                                Margin="0 10 0 0"
                                Height="30" 
                                FontSize="14"
                                Click="ResetFiltersButtonClick"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Button Margin="0 0 30 10"
                        Grid.Row="0" 
                        Panel.ZIndex="10" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="AddUserButtonClick" 
                        ToolTip="Добавить пользователя"
                        Style="{StaticResource MaterialDesignFloatingActionButton}">
                    <materialDesign:PackIcon Kind="Plus"
                                             Width="24"
                                             Height="24"/>
                </Button>

                <DataGrid Name="UsersDataGrid" 
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Grid.Row="0" 
                          SelectionMode="Single">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridRow" 
                               BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <EventSetter Event="PreviewMouseRightButtonDown" 
                                         Handler="PreviewMouseRightButtonDownDataGrid"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" 
                                         Value="True">
                                    <Setter Property="Background" 
                                            Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" 
                                         Value="True">
                                    <Setter Property="Background" 
                                            Value="{DynamicResource MaterialDesignDivider}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Разблокировать"
                                      Click="UnlockUserMenuItemButtonClick"
                                      Name="UnlockMenuItem">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="LockOpenVariant"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Редактировать"
                                      Click="EditUserMenuItemButtonClick">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Pencil"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Удалить" 
                                      Click="DeleteUserMenuItemButtonClick">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Логин" 
                                                MinWidth="200" 
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Login}" 
                                                   VerticalAlignment="Center"
                                                   FontSize="14"/>

                                        <TextBlock VerticalAlignment="Center" 
                                                   Margin="8 0 0 0"
                                                   FontWeight="Bold" 
                                                   FontSize="13"
                                                   Text="(Заблокирован)">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLockedOut}" 
                                                                     Value="True">
                                                            <Setter Property="Visibility" 
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Роль"
                                            MinWidth="150"
                                            Width="200" 
                                            Binding="{Binding Roles.Name}"/>
                        <DataGridTextColumn Header="Ошибки входа"
                                            MinWidth="100" 
                                            Width="150" 
                                            Binding="{Binding FailedAttempts}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Name="EmptyStackPanel"
                            Grid.Row="0" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="SmileySad"
                                             Width="80"
                                             Height="80" 
                                             HorizontalAlignment="Center" 
                                             Foreground="{DynamicResource MaterialDesignDivider}"/>
                    <TextBlock Text="Упс! Ничего не найдено"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0 10 0 0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>

                    <TextBlock Text="Попробуйте изменить параметры поиска или фильтры"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Opacity="0.6"/>

                    <Button Content="Сбросить всё" 
                            Margin="0 20 0 0" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Click="ResetFiltersButtonClick"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="10"
                        VerticalAlignment="Center" 
                        BorderThickness="0 1 0 0"
                        Background="{DynamicResource MaterialDesignPaper}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <Grid>
                        <TextBlock Name="CounterTextBlock" 
                                   Text="Найдено: 0 из 0"
                                   FontSize="18" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <Button Content="&lt;&lt;" 
                                    Height="30" 
                                    Width="50"
                                    Click="FirstPageButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Button Content="&lt;" 
                                    Height="30" 
                                    Width="50" 
                                    Click="PrevPageButtonClick" 
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                            <StackPanel Orientation="Horizontal" 
                                        VerticalAlignment="Center"
                                        Margin="15 0">
                                <TextBlock Text="Страница" 
                                           FontSize="16" 
                                           VerticalAlignment="Center" 
                                           Margin="0 0 8 0"/>
                                <TextBox Name="PageInputTextBox" 
                                         FontSize="16"
                                         Width="30" 
                                         TextAlignment="Center" 
                                         MaxLength="3"
                                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" 
                                         materialDesign:TextFieldAssist.HasClearButton="False" KeyDown="PageInputTextBoxKeyDown" Text="1"/>
                                <TextBlock Name="PageInfoTextBlock" 
                                           FontSize="16"
                                           Text="из 1"
                                           VerticalAlignment="Center" Margin="8 0 0 0"/>
                            </StackPanel>
                            <Button Content="&gt;" 
                                    Height="30" 
                                    Width="50" 
                                    Click="NextPageButtonClick" 
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                            <Button Content="&gt;&gt;"
                                    Height="30"
                                    Width="50"
                                    Click="LastPageButtonClick"
                                    Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Page>
