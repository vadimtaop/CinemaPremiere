<Window x:Class="CinemaPremiereApp.Windows.GeneralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CinemaPremiereApp.Windows"
        xmlns:properties="clr-namespace:CinemaPremiereApp.Properties"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Кинотеатр «Премьера»"
        MinHeight="720"
        MinWidth="1280"
        Height="720"
        Width="1280"
        Icon="../Images/Logo.png"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <materialDesign:DialogHost Name="MainDialogHost"
                               CloseOnClickAway="True"
                               Identifier="GlobalDialogHost">
        <materialDesign:DrawerHost Name="MainDrawerHost">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Width="200">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:ColorZone Mode="PrimaryMid"
                                              Padding="10"
                                              Grid.Row="0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ViewDashboard"
                                                     VerticalAlignment="Center"
                                                     Height="20"
                                                     Width="20"
                                                     Margin="0 0 5 0"/>
                            <TextBlock Text="Меню"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </materialDesign:ColorZone>

                    <ListBox Name="TopMenuListBox"
                             Grid.Row="1"
                             Margin="0 10 0 0"
                             VerticalAlignment="Top"
                             SelectionChanged="MenuListBoxSelectionChanged">
                        <ListBoxItem Name="OrdersItem">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10">
                                <materialDesign:PackIcon Kind="Ticket"
                                                         Width="24"
                                                         Height="24"/>
                                <TextBlock Text="Заказы"
                                           FontSize="16"
                                           Margin="20 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Name="FilmsItem">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10">
                                <materialDesign:PackIcon Kind="Movie"
                                                         Width="24"
                                                         Height="24"/>
                                <TextBlock Text="Фильмы"
                                           FontSize="16"
                                           Margin="20 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Name="ScheduleItem">
                            <StackPanel Orientation="Horizontal"
                                        Margin="10">
                                <materialDesign:PackIcon Kind="ImageEdit"
                                                         Width="24"
                                                         Height="24"/>
                                <TextBlock Text="Расписание"
                                           FontSize="16"
                                           Margin="20 0 0 0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel Grid.Row="2"
                                Margin="0 0 0 10"
                                VerticalAlignment="Bottom">
                        <Separator Style="{StaticResource MaterialDesignLightSeparator}"
                                   Margin="10 0"/>

                        <ListBox Name="BottomMenuListBox"
                                 SelectionChanged="MenuListBoxSelectionChanged">
                            <ListBoxItem Name="SettingsItem">
                                <StackPanel Orientation="Horizontal"
                                            Margin="10">
                                    <materialDesign:PackIcon Kind="Settings"
                                                             Width="24"
                                                             Height="24"/>
                                    <TextBlock Text="Настройки"
                                               FontSize="16"
                                               Margin="20 0 0 0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Name="AboutItem">
                                <StackPanel Orientation="Horizontal"
                                            Margin="10">
                                    <materialDesign:PackIcon Kind="HelpCircle"
                                                             Width="24"
                                                             Height="24"/>
                                    <TextBlock Text="О программе"
                                               FontSize="16"
                                               Margin="20 0 0 0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Name="ExitItem">
                                <StackPanel Orientation="Horizontal"
                                            Margin="10">
                                    <materialDesign:PackIcon Kind="ExitToApp"
                                                             Width="24"
                                                             Height="24"/>
                                    <TextBlock Text="Выйти"
                                               FontSize="16"
                                               Margin="20 0 0 0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <TextBlock Text='© 2026 Кинотеатр "Премьера"'
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.4"
                                   Margin="0 5 0 0"/>
                        <TextBlock Text='Все права защищены'
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.4"
                                   Margin="0 3 0 0"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <materialDesign:Card Grid.Row="0"
                                     Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                     materialDesign:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Button Name="MenuButton"
                                Visibility="Collapsed"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="0"
                                Margin="10 0 0 0"
                                Width="40"
                                Height="40"
                                Click="MenuButtonClick">
                            <materialDesign:PackIcon Kind="Menu"
                                                     Width="40"
                                                     Height="40"/>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="MovieOpen"
                                                     VerticalAlignment="Center"
                                                     Width="28"
                                                     Height="28"
                                                     Margin="0 0 10 0"/>
                            <TextBlock Text="Кинотеатр «Премьера»"
                                       FontWeight="Bold"
                                       FontSize="28"/>
                        </StackPanel>

                        <ToggleButton Name="ThemeToggleButton"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0 0 20 0"
                                      IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=IsDarkMode, Mode=OneWay}"
                                      Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                      Click="ThemeToggleButtonClick">
                            <materialDesign:PackIcon Width="28"
                                                     Height="28">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind"
                                                Value="WbSunny"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=ThemeToggleButton}"
                                                         Value="true">
                                                <Setter Property="Kind"
                                                        Value="MoonWaningCrescent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </ToggleButton>
                    </Grid>
                </materialDesign:Card>

                <Frame Grid.Row="1"
                       Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Source="../Pages/AuthPage.xaml"/>

                <materialDesign:Snackbar Name="MainSnackbar"
                                         Grid.RowSpan="2"
                                         Margin="0 0 0 10"
                                         PreviewMouseLeftButtonDown="MainSnackbarPreviewMouseLeftButtonDown"
                                         MessageQueue="{materialDesign:MessageQueue}"/>
            </Grid>
        </materialDesign:DrawerHost>
    </materialDesign:DialogHost>
</Window>
